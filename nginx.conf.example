# Example Nginx config for admin.cheerytails.com
# Copy to your server and adjust ssl_certificate paths.

server {
    listen 80;
    server_name admin.cheerytails.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.cheerytails.com;

    # ssl_certificate     /etc/letsencrypt/live/admin.cheerytails.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/admin.cheerytails.com/privkey.pem;

    root /var/www/cheerytailsadmin/dist;
    index index.html;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Cache hashed assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
